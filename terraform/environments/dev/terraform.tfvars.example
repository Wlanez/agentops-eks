# Copy to terraform.tfvars before planning.
# Replace the documentation-only IP below with your current public IPv4 /32.
cluster_endpoint_public_access_cidrs = ["198.51.100.10/32"]

aws_region         = "us-west-2"
kubernetes_version = "1.36"

# Cost-aware lab defaults. Increase only when the demo needs it.
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
